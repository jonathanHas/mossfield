#!/usr/bin/env bash
#
# "ship it" from Jon's PC to the mossserv box.
#
# Same job as `ship` (commit → push → deploy-on-prod with maintenance mode),
# tailored to this machine:
#
#   * targets the `mossserv` SSH alias from ~/.ssh/config (user jon,
#     ~/.ssh/id_ed25519) — this PC has no `mossserv-deploy` alias or
#     `id_mossserv_deploy` key, which is what `ship`/`deploy-mossserv` expect;
#   * commits ALL local changes like `ship` does (`git add -A`): anything
#     that must not ship belongs in .gitignore, not in a manual `git add`.
#     `--tracked-only` restores the old behaviour for one run (untracked
#     files are then listed and left alone).
#
# It is a thin wrapper over deploy-mossserv → deploy2 (key auto-load,
# pre-flight checks, summary, confirm, push, remote trigger). Nothing from
# those is re-implemented here.
#
# Usage:
#   deploy/bin/ship-jon [-m "<msg>"] [--no-maintenance] [--tracked-only] [--skip-npm] [--dry-run] [-y] ...
#
#   deploy/bin/ship-jon                  # prompt for a message (blank => timestamp)
#   deploy/bin/ship-jon -m "Fix totals"  # use the given message, skip the prompt
#   deploy/bin/ship-jon --dry-run        # pre-flight + summary only; no push, no SSH deploy
#
# Any flag not listed below passes straight through to deploy-mossserv /
# deploy2 (--skip-npm, --dry-run, -y, --branch=<name>).
#
# NOTE (inherited from ship): deploy2 commits during its pre-flight, BEFORE
# the "Proceed? [y/N]" prompt — and even on --dry-run. If you abort at that
# prompt, the local commit already exists (just not pushed); undo it with
# `git reset --soft HEAD~1`.

set -euo pipefail

# This PC → mossserv. Override by exporting the variables before running.
export MOSSFIELD_PROD_HOST="${MOSSFIELD_PROD_HOST:-mossserv}"
export MOSSFIELD_PROD_PATH="${MOSSFIELD_PROD_PATH:-/var/www/mossfield}"

MAINTENANCE=1
TRACKED_ONLY=0
MSG=""
PASSTHRU=()

while [ $# -gt 0 ]; do
  case "$1" in
    --no-maintenance) MAINTENANCE=0; shift ;;
    --tracked-only) TRACKED_ONLY=1; shift ;;
    -m|--message) MSG="$2"; shift 2 ;;
    --message=*) MSG="${1#*=}"; shift ;;
    -h|--help)
      sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) PASSTHRU+=("$1"); shift ;;
  esac
done

# Resolve our own directory before changing it, so the hand-off below works
# whether this is run as deploy/bin/ship-jon or ./ship-jon from inside deploy/bin.
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$BIN_DIR/../.."

# List the untracked files before deploy2's pre-flight commits, so what is
# about to be added (or, with --tracked-only, left behind) is in plain sight.
UNTRACKED=$(git ls-files --others --exclude-standard)
if [ -n "$UNTRACKED" ]; then
  if [ "$TRACKED_ONLY" -eq 1 ]; then
    echo "ⓘ untracked files — NOT included in the commit (--tracked-only):"
  else
    echo "ⓘ untracked files — these will be added to the commit (ignore them in .gitignore if they shouldn't ship):"
  fi
  echo "$UNTRACKED" | sed 's/^/    /'
  echo
fi

# Prompt for a commit message if none was given; blank reply => timestamp.
if [ -z "$MSG" ]; then
  read -r -p "Commit message (blank = timestamp): " MSG || true
  if [ -z "$MSG" ]; then
    MSG="Deploy $(date '+%Y-%m-%d %H:%M')"
    echo "  ⓘ using auto message: $MSG"
  fi
fi

# deploy-on-prod runs as root on the box via `ssh -t … sudo`. With a
# password-less sudo it runs straight through; otherwise sudo prompts on
# the box during the remote step. Say which, don't fail. The probe uses
# BatchMode, so it can only run once the key is in the agent — deploy2
# loads it later in this same run; until then say so rather than guess.
IDENTITY_FILE=$(ssh -G "$MOSSFIELD_PROD_HOST" 2>/dev/null | awk '/^identityfile /{print $2; exit}')
IDENTITY_FILE="${IDENTITY_FILE/#\~/$HOME}"
KEY_FP=$( [ -f "$IDENTITY_FILE" ] && ssh-keygen -lf "$IDENTITY_FILE" 2>/dev/null | awk '{print $2}' || true)
if [ -z "$KEY_FP" ] || ! ssh-add -l 2>/dev/null | grep -q -- "$KEY_FP"; then
  echo "ⓘ sudo on $MOSSFIELD_PROD_HOST: not checked (key not in the agent yet — deploy2 loads it next;"
  echo "  the remote step prompts for a sudo password on the box if one is needed)."
elif ssh -o BatchMode=yes -o ConnectTimeout=5 "$MOSSFIELD_PROD_HOST" 'sudo -n true' >/dev/null 2>&1; then
  echo "ⓘ sudo on $MOSSFIELD_PROD_HOST: password-less"
else
  echo "ⓘ sudo on $MOSSFIELD_PROD_HOST: not password-less (or host unreachable) —"
  echo "  expect a password prompt on the box during the remote step."
fi

# Build the deploy-mossserv argument list: -m, --include-untracked unless
# --tracked-only, --maintenance only when on, then passthrough.
ARGS=(-m "$MSG")
[ "$TRACKED_ONLY" -eq 0 ] && ARGS+=(--include-untracked)
[ "$MAINTENANCE" -eq 1 ] && ARGS+=(--maintenance)
[ "${#PASSTHRU[@]}" -gt 0 ] && ARGS+=("${PASSTHRU[@]}")

exec "$BIN_DIR/deploy-mossserv" "${ARGS[@]}"
